{
  "name": "lorebank-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate": "openapi-typescript ../backend/openapi/lorebank.json -o src/api/schema.d.ts",
    "prepare": "npm run generate",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "format": "biome check --write",
    "audit": "npm audit --audit-level=high",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "jsdom": "30.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "5.0.0"
  }
}
