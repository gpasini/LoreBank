<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../openapi</OpenApiDocumentsDirectory>
        <OpenApiGenerateDocumentsOptions>--file-name lorebank</OpenApiGenerateDocumentsOptions>

        <!-- L'image OCI (ADR 0039) : `dotnet publish /t:PublishContainer`, sans
             Dockerfile — la toolchain reste celle de mise et de global.json.
             Base Alpine, donc RID musl ; deux architectures en un publish, un
             manifeste multi-arch. Nom et tag locaux : le registre est au
             cloneur (ContainerRegistry). -->
        <ContainerRepository>lorebank</ContainerRepository>
        <ContainerImageTag>latest</ContainerImageTag>
        <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-alpine</ContainerBaseImage>
        <ContainerRuntimeIdentifiers>linux-musl-x64;linux-musl-arm64</ContainerRuntimeIdentifiers>
        <!-- Le restore doit connaître les deux RID, sinon le publish par RID
             s'arrête sur NETSDK1047. -->
        <RuntimeIdentifiers>linux-musl-x64;linux-musl-arm64</RuntimeIdentifiers>
        <!-- La Description est émise par le build ordinaire (ADR 0019), jamais
             par un publish ciblé sur un RID : le binaire musl ne se charge pas
             sur le poste, et le fichier est déjà commité. -->
        <OpenApiGenerateDocuments Condition="'$(RuntimeIdentifier)' != ''">false</OpenApiGenerateDocuments>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Autofac.Extensions.DependencyInjection"/>
        <!-- Émet la Description OpenAPI à chaque build (ADR 0019) : le tool
             compose l'hôte comme l'API puis écrit backend/openapi/lorebank.json,
             que la CI compare au fichier commité. -->
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- La Télémétrie (ADR 0025) : l'hôte seul référence OpenTelemetry. -->
        <PackageReference Include="OpenTelemetry.Extensions.Hosting"/>
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore"/>
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol"/>
        <PackageReference Include="Scalar.AspNetCore"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LoreBank.Bank.Api\LoreBank.Bank.Api.csproj"/>
        <ProjectReference Include="..\LoreBank.Bank.Infrastructure\LoreBank.Bank.Infrastructure.csproj"/>
        <ProjectReference Include="..\LoreBank.Ledger.Api\LoreBank.Ledger.Api.csproj"/>
        <ProjectReference Include="..\LoreBank.Ledger.Infrastructure\LoreBank.Ledger.Infrastructure.csproj"/>
        <ProjectReference Include="..\LoreBank.SharedKernel.Api\LoreBank.SharedKernel.Api.csproj"/>
        <ProjectReference Include="..\LoreBank.SharedKernel.Infrastructure\LoreBank.SharedKernel.Infrastructure.csproj"/>
    </ItemGroup>

</Project>
