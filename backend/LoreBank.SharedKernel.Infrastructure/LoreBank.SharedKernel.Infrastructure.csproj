<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <PackageReference Include="Autofac"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <!-- Le check de Disponibilité des bases de modules (ADR 0022). -->
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions"/>
        <!-- BackgroundService, pour le dépileur d'outbox de l'hôte. -->
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
        <!-- Le provider est une décision du socle (ADR 0008) : les modules
             l'héritent en transitif, aucun PackageReference à recopier. -->
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Les ports des Signaux (ISignalStream, ISignalPolicy — ADR 0026)
             sont déclarés dans l'Application, parce que l'Api les consomme,
             et implémentés ici — la même direction que l'Infrastructure d'un
             module vers son Application (readers, ADR 0018). -->
        <ProjectReference Include="..\LoreBank.SharedKernel.Application\LoreBank.SharedKernel.Application.csproj"/>
        <ProjectReference Include="..\LoreBank.SharedKernel.Contracts\LoreBank.SharedKernel.Contracts.csproj"/>
        <ProjectReference Include="..\LoreBank.SharedKernel.Domain\LoreBank.SharedKernel.Domain.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Le parsing de ModuleAssemblyName est interne : ses cas d'échec se testent sur des chaînes. -->
        <InternalsVisibleTo Include="LoreBank.SharedKernel.Test.Unit"/>
        <!-- Les stores d'integration events et le geste SQL du socle sont internes : leur seul
             appelant hors production est le harnais, qui observe ce qu'ils ont écrit plutôt que
             de réécrire leurs colonnes. -->
        <InternalsVisibleTo Include="LoreBank.SharedKernel.Test.Infrastructure"/>
    </ItemGroup>

</Project>
