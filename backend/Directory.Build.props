<Project>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- La doctrine « build sans warning » (CLAUDE.md, Vérification) tenue
             par le compilateur plutôt que par la discipline. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Les portes de qualité tenues par le build (ADR 0028, docs/qualite.md) :
             les règles CA recommandées et les règles de style IDE que
             .editorconfig élève à warning deviennent des erreurs par la ligne
             du dessus. Le reste des gates (format, front, audit npm) vit dans
             les tâches mise et la CI. -->
        <AnalysisMode>Recommended</AnalysisMode>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <!-- L'audit NuGet du restore (NU1901–NU1904) est la gate de
             vulnérabilités du back : ces deux valeurs sont les défauts du SDK,
             épinglés pour qu'un changement de défaut ne desserre rien en
             silence — toutes les sévérités, transitives comprises, et
             TreatWarningsAsErrors les rend bloquantes. -->
        <NuGetAuditMode>all</NuGetAuditMode>
        <NuGetAuditLevel>low</NuGetAuditLevel>
    </PropertyGroup>

    <!-- Le temps reçu, jamais demandé (ADR 0024) : le Domain reçoit l'Instant
         en paramètre, l'Application le demande à TimeProvider. L'analyseur
         d'API bannies fait échouer le build d'un Domain ou d'une Application —
         socle inclus — qui lirait l'horloge en direct ; les symboles et le
         message vivent dans BannedSymbols.txt. -->
    <!-- La couverture est une mesure, pas une porte (ADR 0029) : le data
         collector est déclaré ici, une fois pour tous les projets de test,
         et ne collecte que si `mise run coverage` le demande
         (option collect « XPlat Code Coverage », exclusions dans coverage.runsettings). -->
    <ItemGroup Condition="$(MSBuildProjectName.Contains('.Test.'))">
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Domain')) Or $(MSBuildProjectName.EndsWith('.Application'))">
        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all"/>
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt"/>
    </ItemGroup>

</Project>
