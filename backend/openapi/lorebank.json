        "required": [
          "iban",
          "currency"
        ],
        "type": "object",
        "properties": {
          "iban": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "Signal": {
        "required": [
          "discriminant",
          "resourceKind",
          "resourceId",
          "occurredAt"
        ],
        "type": "object",
        "properties": {
          "discriminant": {
            "type": "string"
          },
          "resourceKind": {
            "type": "string"
          },
          "resourceId": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WithdrawMoneyCommand": {
        "required": [
          "amount",
          "currency"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          }
        }
      }
    }
