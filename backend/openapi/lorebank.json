  "components": {
    "schemas": {
      "ApiProblem": {
        "required": [
          "title",
          "status",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": { }
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "BankAccountLedgerResult": {
        "required": [
          "accountId",
          "iban",
          "movements"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "iban": {
            "type": "string"
          },
          "movements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LedgerMovementResult"
            }
          }
        }
      },
      "BankAccountResult": {
        "required": [
          "id",
          "iban",
          "balance",
          "currency",
          "isClosed",
          "openedBy",
          "openedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "iban": {
            "type": "string"
          },
          "balance": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "isClosed": {
            "type": "boolean"
          },
          "openedBy": {
            "type": [
              "null",
              "string"
            ]
          },
          "openedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BankAccountsResult": {
        "required": [
          "accounts"
        ],
        "type": "object",
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BankAccountSummaryResult"
            }
          }
        }
      },
      "BankAccountSummaryResult": {
        "required": [
          "id",
          "iban",
          "balance",
          "currency",
          "isClosed",
          "openedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "iban": {
            "type": "string"
          },
          "balance": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "isClosed": {
            "type": "boolean"
          },
          "openedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DepositMoneyCommand": {
        "required": [
          "amount",
          "currency"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "ErrorCode": {
        "enum": [
          "BANK.ACCOUNT_CLOSED",
          "BANK.BANK_ACCOUNT_NOT_FOUND",
          "BANK.INSUFFICIENT_BALANCE",
          "BANK.NON_EMPTY_ACCOUNT_CLOSURE",
          "CONCURRENT_UPDATE",
          "CURRENCY_MISMATCH",
          "INVALID_ACTOR",
          "INVALID_BIC",
          "INVALID_CURRENCY",
          "INVALID_IBAN",
          "INVALID_SIGNAL_RESOURCE",
          "LEDGER.EMPTY_JOURNAL_ENTRY",
          "LEDGER.INVALID_LEDGER_ACCOUNT_REF",
          "LEDGER.JOURNAL_ENTRY_NOT_FOUND",
          "LEDGER.UNBALANCED_JOURNAL_ENTRY",
          "LEDGER.UNKNOWN_BANK_ACCOUNT",
          "NON_POSITIVE_AMOUNT",
          "VALIDATION_FAILED"
        ],
        "type": "string"
      },
      "LedgerMovementResult": {
        "required": [
          "entryId",
          "direction",
          "amount",
          "currency",
          "recordedAt"
        ],
        "type": "object",
        "properties": {
          "entryId": {
            "type": "string",
            "format": "uuid"
          },
          "direction": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
