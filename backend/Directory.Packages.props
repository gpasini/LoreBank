<Project>

    <!-- Central package management : l'unique endroit où une version de package
         existe. Les csproj référencent sans version — un pin (licence, avis de
         sécurité) est un fait unique ici, pas un accord tacite entre copies. -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="Autofac" Version="8.4.0"/>
        <PackageVersion Include="Autofac.Extensions.DependencyInjection" Version="11.0.2"/>
        <!-- Pinné en 7.x : dernière version sous licence Apache 2.0. -->
        <PackageVersion Include="FluentAssertions" Version="7.2.0"/>
        <!-- Pinné en 12.x : dernière version sous licence Apache 2.0. -->
        <PackageVersion Include="MediatR" Version="12.5.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0"/>
        <!-- Le temps reçu, jamais demandé (ADR 0024) : bannit la lecture directe
             de l'horloge dans tout projet .Domain et .Application — activé par
             suffixe dans Directory.Build.props. Microsoft, licence MIT. -->
        <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0"/>
        <!-- Émet la Description OpenAPI au build de l'hôte (ADR 0019). -->
        <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.0"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0"/>
        <!-- IHealthCheck seul : le check de Disponibilité vit dans le socle
             (ADR 0022), l'enregistrement et les routes dans l'hôte. -->
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0"/>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1"/>
        <!-- Relève la dépendance transitive de Microsoft.AspNetCore.OpenApi :
             la 2.0.0 qu'il référence est sous avis de sécurité (NU1903,
             GHSA-v5pm-xwqc-g5wc, corrigé en 2.7.5). Reste en 2.x — la ligne
             attendue par le package. -->
        <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2"/>
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0"/>
        <PackageVersion Include="NUnit" Version="4.4.0"/>
        <!-- La Télémétrie (ADR 0025) : référencée par l'hôte seul — le socle et
             les modules posent Activity et Meter en BCL. Apache 2.0. -->
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0"/>
        <!-- Gardée bien que le span serveur soit natif : en .NET 10 il n'a ni
             statut ni route, natifs en .NET 11 seulement. -->
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0"/>
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0"/>
        <!-- L'exporteur du harnais : prouve le câblage de l'hôte sans réseau. -->
        <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.18.0"/>
        <PackageVersion Include="NUnit3TestAdapter" Version="6.1.0"/>
        <PackageVersion Include="Scalar.AspNetCore" Version="2.17.2"/>
        <!-- Relève la dépendance transitive d'EF Sqlite : la 2.1.11 qu'il
             référence est sous avis de sécurité (NU1903, GHSA-2m69-gcr7-jv3q). -->
        <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13"/>
        <!-- Pin d'une dépendance transitive de Testcontainers. -->
        <PackageVersion Include="SSH.NET" Version="2026.0.0"/>
        <!-- Relève une transitive de Microsoft.EntityFrameworkCore.Design (via
             Microsoft.Build.Tasks.Core) : la 9.0.0 qu'il référence est sous
             avis de sécurité (NU1903, GHSA-w3x6-4m5h-cxqf entre autres). -->
        <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11"/>
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.10.0"/>
    </ItemGroup>

</Project>
